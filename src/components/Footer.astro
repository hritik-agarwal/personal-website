---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap row">
    <p>© {year} {site.name}</p>
    <p><a href="/rss.xml">RSS</a></p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 3rem;
    border-top: 1px solid var(--rule);
    font-size: 1rem;
    color: var(--quiet);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2.5rem;
  }
</style>
