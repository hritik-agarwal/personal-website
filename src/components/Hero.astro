---
/**
 * The home page hero: a midnight page with a lamp that follows the pointer,
 * lighting up the dot grid of a journal page beneath the headline.
 * On touch screens the lamp drifts on its own; with reduced motion it holds still.
 */
import { hero } from '../data/site';
---

<section class="hero" aria-label="Introduction">
  <div class="wrap">
    <h1>
      {
        hero.headline.map((line, i) => (
          <span class="line" style={`--i: ${i}`}>
            {line}
          </span>
        ))
      }
    </h1>
    <p class="claim">{hero.claim}</p>
  </div>
</section>

<style>
  .hero {
    --mx: 28%;
    --my: 38%;
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: 100svh;
    padding-block: 9rem 4rem;
    background: var(--night);
    color: var(--paper);
    overflow: hidden;
  }
  /* The journal's dot grid, visible only where the lamp reaches */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(circle, rgba(251, 250, 246, 0.45) 1px, transparent 1.6px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(circle 26rem at var(--mx) var(--my), #000, transparent 70%);
    mask-image: radial-gradient(circle 26rem at var(--mx) var(--my), #000, transparent 70%);
  }
  /* The lamp */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle 42rem at var(--mx) var(--my), rgba(255, 181, 71, 0.32), transparent 70%);
    animation: glow 1.6s ease-out both;
  }
  h1 {
    display: grid;
    font-size: clamp(3rem, 10.5vw, 9.5rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.035em;
  }
  .line {
    display: block;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.12s);
  }
  .claim {
    margin-top: 2rem;
    max-width: 36ch;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.45;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) 0.5s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.2em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes glow {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');

  if (hero) {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let tx = 0.28;
    let ty = 0.38;
    let x = tx;
    let y = ty;
    let raf = 0;

    const frame = (t: number) => {
      if (!fine) {
        tx = 0.5 + 0.28 * Math.sin(t / 4200);
        ty = 0.42 + 0.18 * Math.cos(t / 5600);
      }
      x += (tx - x) * 0.08;
      y += (ty - y) * 0.08;
      hero.style.setProperty('--mx', `${(x * 100).toFixed(2)}%`);
      hero.style.setProperty('--my', `${(y * 100).toFixed(2)}%`);
      raf = requestAnimationFrame(frame);
    };

    if (fine) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width;
        ty = (e.clientY - r.top) / r.height;
      });
    }

    if (!still) {
      document.addEventListener('visibilitychange', () => {
        cancelAnimationFrame(raf);
        if (!document.hidden) raf = requestAnimationFrame(frame);
      });
      raf = requestAnimationFrame(frame);
    }
  }
</script>
