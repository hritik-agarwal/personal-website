---
/**
 * Work and study, newest first: a spine through each entry's logo, or a
 * dot where there is none. Amber marks the entry whose years end in "now".
 */
import type { TimelineEntry } from '../data/site';

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
const isCurrent = (years: string) => /now$/i.test(years);
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li class:list={{ current: isCurrent(entry.years), 'has-logo': Boolean(entry.logo) }}>
        {entry.logo && <img class="logo" src={entry.logo} alt="" width="44" height="44" loading="lazy" />}
        <p class="years">{entry.years}</p>
        <p class="role">{entry.role}</p>
        <p class="place">{entry.href ? <a href={entry.href}>{entry.place}</a> : entry.place}</p>
        <p class="note">{entry.note}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --mark: 2.75rem;
    position: relative;
    display: grid;
    gap: 2.75rem;
    padding-left: calc(var(--mark) + 1.25rem);
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: calc(var(--mark) / 2 - 1px);
    width: 2px;
    background: var(--rule);
  }
  li {
    position: relative;
  }
  li::before {
    content: '';
    position: absolute;
    top: 0.35rem;
    left: calc(-1.25rem - var(--mark) / 2 - 0.45rem);
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--quiet);
    border-radius: 50%;
    background: var(--paper);
  }
  li.current::before {
    border-color: var(--lamp);
    background: var(--lamp);
  }
  li.has-logo::before {
    display: none;
  }
  .logo {
    position: absolute;
    top: -0.15rem;
    left: calc(-1.25rem - var(--mark));
    width: var(--mark);
    height: var(--mark);
    padding: 0.3rem;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
  }
  li.current .logo {
    border-color: var(--lamp);
    box-shadow: 0 0 0 2px var(--lamp);
  }
  .years {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--quiet);
  }
  .role {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .place {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
  }
  .note {
    margin-top: 0.7rem;
    max-width: 60ch;
    color: var(--quiet);
  }
</style>
