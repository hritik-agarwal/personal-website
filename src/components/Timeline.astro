---
/**
 * Work and study, newest first. Each entry's logo, or a dot where there is
 * none, sits level with the role, and a spine joins each mark to the next.
 * Amber marks the entry whose years end in "now".
 */
import type { TimelineEntry } from '../data/site';

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
const isCurrent = (years: string) => /now$/i.test(years);
---

<ol class="timeline">
  {
    entries.map((entry) => (
      <li class:list={{ current: isCurrent(entry.years), 'has-logo': Boolean(entry.logo) }}>
        {entry.logo && <img class="logo" src={entry.logo} alt="" width="44" height="44" loading="lazy" />}
        <p class="years">{entry.years}</p>
        <p class="role">{entry.role}</p>
        <p class="place">{entry.href ? <a href={entry.href}>{entry.place}</a> : entry.place}</p>
        <p class="note">{entry.note}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --mark: 2.75rem;
    --years: 1.5rem; /* the years line; the mark column starts below it */
    display: grid;
    gap: var(--space-item);
    list-style: none;
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--mark) minmax(0, 1fr);
    grid-template-rows: var(--years);
    grid-template-areas:
      '. years'
      'mark role'
      'mark place'
      '. note';
    column-gap: 1.25rem;
  }
  /* The spine, from inside this entry's mark to inside the next one's */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--years) + 1rem);
    left: calc(var(--mark) / 2 - 1px);
    width: 2px;
    height: calc(100% + var(--space-item));
    background: var(--rule);
  }
  /* The dot, level with the role's first line */
  li::before {
    content: '';
    position: relative;
    z-index: 1;
    grid-area: mark;
    align-self: start;
    justify-self: center;
    margin-top: 0.6rem;
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--quiet);
    border-radius: 50%;
    background: var(--paper);
  }
  li.current::before {
    border-color: var(--lamp);
    background: var(--lamp);
  }
  li.has-logo::before {
    display: none;
  }
  /* The logo, its top level with the role's top */
  .logo {
    position: relative;
    z-index: 1;
    grid-area: mark;
    align-self: start;
    margin-top: 0.3rem;
    width: var(--mark);
    height: var(--mark);
    padding: 0.3rem;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 0.6rem;
  }
  li.current .logo {
    border-color: var(--lamp);
    box-shadow: 0 0 0 2px var(--lamp);
  }
  .years {
    grid-area: years;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-meta);
    line-height: var(--years);
    color: var(--quiet);
  }
  .role {
    grid-area: role;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-title);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .place {
    grid-area: place;
    margin-top: 0.125rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-meta);
  }
  .note {
    grid-area: note;
    margin-top: 0.5rem;
    max-width: 58ch;
    color: var(--quiet);
  }
</style>
