---
/** A line on how to get in touch, then every place to do it, email first. */
import { contact, links } from '../data/site';
---

<p class="blurb">{contact.blurb}</p>
<ul class="links">
  {
    links.map((link) => (
      <li>
        <span class="label">{link.label}</span>
        <a href={link.href}>{link.handle}</a>
      </li>
    ))
  }
</ul>

<style>
  .blurb {
    margin-bottom: var(--space-heading);
  }
  .links {
    display: grid;
    gap: 0.75rem;
    list-style: none;
  }
  /* The same label column as the post list, so the two line up */
  li {
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: 1.5rem;
    align-items: baseline;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-meta);
    color: var(--quiet);
  }
  a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-body);
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--lamp);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 40rem) {
    .links {
      gap: 1rem;
    }
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
