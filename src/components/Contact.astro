---
/** A line on how to get in touch, then every place to do it, email first. */
import { contact, links } from '../data/site';
---

<p class="blurb">{contact.blurb}</p>
<ul class="links">
  {
    links.map((link) => (
      <li>
        <span class="label">{link.label}</span>
        <a href={link.href}>{link.handle}</a>
      </li>
    ))
  }
</ul>

<style>
  .blurb {
    max-width: 48ch;
    margin-bottom: 1.75rem;
  }
  .links {
    display: grid;
    gap: 0.7rem;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--quiet);
  }
  a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--lamp);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>
