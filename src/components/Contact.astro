---
/** The email address, then everywhere else. */
import { links } from '../data/site';

const email = links.find((link) => link.label === 'Email');
const elsewhere = links.filter((link) => link !== email);
---

{
  email && (
    <p class="mail">
      <a href={email.href}>{email.handle}</a>
    </p>
  )
}
<ul class="elsewhere">
  {
    elsewhere.map((link) => (
      <li>
        <a href={link.href}>{link.label}</a>
      </li>
    ))
  }
</ul>

<style>
  .mail a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.375rem;
    overflow-wrap: anywhere;
    text-decoration-color: var(--lamp);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }
</style>
