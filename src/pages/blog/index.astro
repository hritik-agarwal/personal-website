---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { blog } from '../../data/site';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))];
---

<Base title={blog.title} description={blog.lede}>
  <div class="wrap">
    <header class="intro">
      <h1>{blog.title}</h1>
      <p class="lede">{blog.lede}</p>
    </header>

    {
      years.map((year) => (
        <section class="section" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <PostList posts={posts.filter((post) => post.data.pubDate.getFullYear() === year)} />
        </section>
      ))
    }

    {
      posts.length === 0 && (
        <p class="empty">
          Nothing published yet. The first post goes in <code>src/data/blog</code>.
        </p>
      )
    }
  </div>
</Base>

<style>
  .empty {
    margin-top: var(--space-item);
    color: var(--quiet);
  }
</style>
