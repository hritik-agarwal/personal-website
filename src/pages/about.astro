---
import Base from '../layouts/Base.astro';
import { about, links } from '../data/site';
import '../styles/about.css';

const email = links.find((link) => link.label === 'Email');
const elsewhere = links.filter((link) => link !== email);
const isCurrent = (years: string) => /now$/i.test(years);
---

<Base title="About" description={about.lede} tone="night">
  <header class="about-head">
    <div class="wrap">
      <h1>{about.lede}</h1>
      <div class="story">{about.paragraphs.map((text) => <p>{text}</p>)}</div>
    </div>
  </header>

  <div class="wrap about-body">
    <section aria-labelledby="timeline">
      <h2 id="timeline">Timeline</h2>
      <ol class="timeline">
        {
          about.timeline.map((entry) => (
            <li class:list={{ current: isCurrent(entry.years) }}>
              <p class="years">{entry.years}</p>
              <h3>{entry.role}</h3>
              <p class="place">{entry.href ? <a href={entry.href}>{entry.place}</a> : entry.place}</p>
              <p class="note">{entry.note}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="tools">
      <h2 id="tools">What I work with</h2>
      <div class="stack">
        {
          about.stack.map((group) => (
            <div>
              <h3>{group.group}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Say hello</h2>
      {
        email && (
          <p class="mail">
            <a href={email.href}>{email.handle}</a>
          </p>
        )
      }
      <ul class="elsewhere">
        {
          elsewhere.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
