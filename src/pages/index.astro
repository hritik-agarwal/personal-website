---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Stack from '../components/Stack.astro';
import PostList from '../components/PostList.astro';
import Contact from '../components/Contact.astro';
import { about, blog } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<Base home>
  <div class="wrap home">
    <section class="section" id="about" aria-label="About">
      <div class="bio">{about.paragraphs.map((text) => <p set:html={text} />)}</div>

      <section class="section" aria-labelledby="story-heading">
        <h2 id="story-heading">The story so far</h2>
        <Timeline entries={about.timeline} />
      </section>

      <section class="section" aria-labelledby="tools-heading">
        <h2 id="tools-heading">Tools of the trade</h2>
        <Stack groups={about.stack} />
      </section>
    </section>

    <section class="section" id="blog" aria-labelledby="blog-heading">
      <h2 id="blog-heading">{blog.title}</h2>
      {
        posts.length > 0 ? (
          <Fragment>
            <PostList posts={posts} />
            <p class="more">
              <a href="/blog">All posts</a>
            </p>
          </Fragment>
        ) : (
          <p class="empty">Nothing published yet. The first post is being written.</p>
        )
      }
    </section>

    <section class="section" id="hello" aria-labelledby="hello-heading">
      <h2 id="hello-heading">Say hello</h2>
      <Contact />
    </section>
  </div>
</Base>

<style>
  .home {
    padding-top: calc(var(--space-section) * 1.25);
  }
  /* The opening: the largest text on the page, in the reading face */
  .bio {
    font-size: var(--text-bio);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .more {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .empty {
    color: var(--quiet);
  }
</style>
