---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Stack from '../components/Stack.astro';
import PostList from '../components/PostList.astro';
import Contact from '../components/Contact.astro';
import { about, blog } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <div class="wrap">
    <section class="section first" id="about" aria-labelledby="about-heading">
      <h2 id="about-heading">About</h2>
      <p class="lede">{about.lede}</p>
      <div class="bio">{about.paragraphs.map((text) => <p>{text}</p>)}</div>
      <h3 class="sub">Timeline</h3>
      <Timeline entries={about.timeline} />
      <h3 class="sub">What I work with</h3>
      <Stack groups={about.stack} />
    </section>

    <section class="section" id="blog" aria-labelledby="blog-heading">
      <h2 id="blog-heading">{blog.title}</h2>
      <p class="lede">{blog.lede}</p>
      {
        posts.length > 0 ? (
          <Fragment>
            <PostList posts={posts} />
            <p class="more">
              <a href="/blog">All posts</a>
            </p>
          </Fragment>
        ) : (
          <p class="empty">Nothing published yet.</p>
        )
      }
    </section>

    <section class="section" id="hello" aria-labelledby="hello-heading">
      <h2 id="hello-heading">Say hello</h2>
      <Contact />
    </section>
  </div>
</Base>

<style>
  .first {
    padding-top: 2rem;
  }
  .lede {
    margin: 0 0 2rem;
  }
  .bio {
    max-width: 60ch;
  }
  .sub {
    margin: 3.5rem 0 1.5rem;
    font-size: 1.125rem;
    color: var(--quiet);
  }
  .more {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .empty {
    color: var(--quiet);
  }
</style>
