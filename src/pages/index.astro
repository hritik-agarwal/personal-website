---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Stack from '../components/Stack.astro';
import PostList from '../components/PostList.astro';
import Contact from '../components/Contact.astro';
import { about, blog } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 5);
---

<Base home>
  <div class="wrap">
    <section class="section first" id="about" aria-label="About">
      <div class="bio">{about.paragraphs.map((text) => <p set:html={text} />)}</div>
      <h2 class="sub">Timeline</h2>
      <Timeline entries={about.timeline} />
      <h2 class="sub">What I have worked with</h2>
      <Stack groups={about.stack} />
    </section>

    <section class="section" id="blog" aria-labelledby="blog-heading">
      <h2 id="blog-heading">{blog.title}</h2>
      <p class="lede">{blog.lede}</p>
      {
        posts.length > 0 ? (
          <Fragment>
            <PostList posts={posts} />
            <p class="more">
              <a href="/blog">All posts</a>
            </p>
          </Fragment>
        ) : (
          <p class="empty">Nothing published yet.</p>
        )
      }
    </section>

    <section class="section" id="hello" aria-labelledby="hello-heading">
      <h2 id="hello-heading">Say hello</h2>
      <Contact />
    </section>
  </div>
</Base>

<style>
  .first {
    padding-top: 5rem;
  }
  .bio {
    max-width: 58ch;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.55;
  }
  /* The words that matter, set in the display face against the serif */
  .bio :global(strong) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.94em;
  }
  .sub {
    margin: 3.5rem 0 1.5rem;
    font-size: 1.125rem;
    color: var(--quiet);
  }
  .lede {
    margin: 0 0 2rem;
  }
  .more {
    margin-top: 2rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .empty {
    color: var(--quiet);
  }
</style>
